# The Liquid Platinum desktop: what maryui-desktop (compiled by the builder's
# ui stage from MaryUI/linux) needs at runtime. Installed at the target stage
# for every target, so a change here costs a target build, not a bootstrap.
#
# Compositor: wlroots 0.17 and its seat/input/keymap libraries.
libwlroots12t64
libseat1
libinput10
libxkbcommon0
xkb-data
libwayland-server0
libwayland-client0
libpixman-1-0
# Drawing: Cairo and Pango draw every surface, FreeType/fontconfig shape the text.
libcairo2
libpango-1.0-0
libpangocairo-1.0-0
libfontconfig1
# DRM/KMS and the GPU path (GLES2 on the Pi's vc4/v3d; the VM uses pixman).
libdrm2
libgbm1
libegl1
libgles2
libgl1-mesa-dri
# The molten wallpaper renders through a surfaceless EGL context: on the Pi
# that is v3d, in the VM it is llvmpipe. Both arrive through mesa's EGL driver.
libegl-mesa0
# The desktop runs as a logind session started by a systemd unit (PAMName=);
# libseat activates that session through logind, which asks polkit.
libpam-systemd
polkitd
# Fonts standing in for the web's system stacks (font.ui, font.display, font.mono).
fonts-inter
fonts-urw-base35
fonts-jetbrains-mono
# A Wayland terminal, opened from File > New Terminal.
foot
# The system apps (MaryUI/linux src/apps): the libraries libmaryui links for
# them, and what they need at run time. The builder image carries the -dev
# packages; a library listed here must match one there, or the desktop will
# not start on an image that lacks it.
# Terminal: libvterm's screen model.
libvterm0
# Preview: pictures through gdk-pixbuf (SVG through librsvg's loader), PDFs through poppler.
libgdk-pixbuf-2.0-0
librsvg2-common
libpoppler-glib8t64
# Calendar: .ics files through libical.
libical3t64
# System Settings and Disk Utility speak to system services over sd-bus; udisks2 mounts and ejects.
libsystemd0
udisks2
# Media Player: GStreamer's playbin and the common codecs, played out through PipeWire.
libgstreamer1.0-0
libgstreamer-plugins-base1.0-0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-libav
gstreamer1.0-pipewire
pipewire
wireplumber
rtkit
# System Settings › Network: iwd joins Wi-Fi networks (configured by overlay-desktop/etc/iwd
# and hooks/desktop/62-wifi.sh); networkd keeps addressing, as for the wired link.
iwd
# Mary (linux/mary, the builder's mary stage): what sewnd, threadd and maryd link.
# sherpa-onnx, for the wake word, ships inside out/mary (/usr/lib/maryos/sherpa-onnx),
# not from apt; ca-certificates, which sewnd verifies Mistral against, is in base.list.
libjson-c5
libcurl4t64
libwebsockets19t64
libssl3t64
libnghttp2-14
libprotobuf-c1
libpipewire-0.3-0t64
