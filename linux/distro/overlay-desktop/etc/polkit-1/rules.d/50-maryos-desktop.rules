// MaryOS: what System Settings and Disk Utility offer, the desktop's user may do
// without an authentication dialog — there is no polkit agent in the session to
// show one. Only for a local, active session of a member of the sudo group, who
// could do all of it with sudo anyway; everything else keeps its default.
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("sudo")) {
        return polkit.Result.NOT_HANDLED;
    }
    var allowed = [
        "org.freedesktop.timedate1.set-timezone",
        "org.freedesktop.timedate1.set-ntp",
        "org.freedesktop.timedate1.set-time",
        "org.freedesktop.hostname1.set-hostname",
        "org.freedesktop.hostname1.set-static-hostname",
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.filesystem-mount-system",
        "org.freedesktop.udisks2.filesystem-unmount-others",
        "org.freedesktop.udisks2.eject-media",
        "org.freedesktop.udisks2.eject-media-system",
        "org.freedesktop.udisks2.power-off-drive",
        "org.freedesktop.udisks2.power-off-drive-system"
    ];
    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
