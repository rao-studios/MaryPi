# indexd (linux/mary/index): every file in the home has a record in the Thread. A user
# unit with no [Install]: the desktop launcher (/usr/lib/maryos/desktop) starts it
# inside the graphical session beside maryd. It reads the home, talks to threadd over
# /run/thread/local.sock (the user is in the thread group) and never touches the
# network. Low priority: the desktop and the voice come first.
[Unit]
Description=indexd: the home, recorded in the Thread
Documentation=file:/usr/share/doc/mary/README.md

[Service]
Type=simple
ExecStart=/usr/bin/indexd
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
